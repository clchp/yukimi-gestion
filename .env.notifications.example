# Worker de notificaciones (local o GitHub Actions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
PUBLIC_APP_URL=http://localhost:5173

# Web Push (VAPID)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:soporte@example.com

# Correo con Resend
RESEND_API_KEY=
EMAIL_FROM=Yukimi Gestion <onboarding@resend.dev>

# Alternativas opcionales
EMAIL_WEBHOOK_URL=
PUSH_GATEWAY_URL=
PUSH_GATEWAY_TOKEN=

# Ajustes opcionales del worker
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_WORKER_ID=local-yukimi
